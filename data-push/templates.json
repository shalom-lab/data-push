{
  "my-project": {
      "name": "🚀 我的项目1",
      "filename": "data-raw/projects.json",
      "fieldOrder": [
      "title",
      "link",
      "description",
      "category",
      "tags"
  ],
      "fields": {
          "title": {
          "type": "text",
          "label": "项目名称",
          "required": true
  },
          "link": {
          "type": "url",
          "label": "项目链接",
          "required": false
  },
          "description": {
          "type": "textarea",
          "label": "项目描述",
          "required": true
  },
          "category": {
          "type": "text",
          "label": "项目分类",
          "required": false
  },
          "tags": {
          "type": "array",
          "label": "标签",
          "required": false,
          "placeholder": "输入后按回车或空格",
          "default": []
  }
      }
  },
  "field_types": {
      "name": "🔎 模板示例",
      "filename": "data-raw/examples.json",
      "fieldOrder": [
      "text_example",
      "textarea_example",
      "select_example",
      "date_example",
      "number_example",
      "checkbox_example",
      "radio_example",
      "array_example"
  ],
      "fields": {
          "text_example": {
          "type": "text",
          "label": "文本输入",
          "required": true,
          "default": "默认文本"
  },
          "textarea_example": {
          "type": "textarea",
          "label": "多行文本",
          "required": true,
          "default": "默认多行文本内容"
  },
          "select_example": {
          "type": "select",
          "label": "下拉选择",
          "required": true,
          "default": "选项B",
          "options": [
          "选项A",
          "选项B",
          "选项C"
  ]
  },
          "date_example": {
          "type": "date",
          "label": "日期选择",
          "required": false
  },
          "number_example": {
          "type": "number",
          "label": "数字输入",
          "required": false
  },
          "checkbox_example": {
          "type": "checkbox",
          "label": "是否启用",
          "required": false,
          "default": false
  },
          "radio_example": {
          "type": "radio",
          "label": "选择性别",
          "required": true,
          "default": "男",
          "options": [
          "男",
          "女",
          "其他"
  ]
  },
          "array_example": {
          "type": "array",
          "label": "标签",
          "required": true,
          "placeholder": "输入后按回车或空格",
          "default": []
  }
      }
  }
}